# lc-forge 本地 AI 构建修复配置示例。
#
# 用法：复制本文件为仓库根的 .env 后填写；.env 已在 .gitignore 中，不要提交真实密钥。
# 优先级：真实环境变量 > .env。同名变量已在环境中设置时，本文件的值被忽略。
# 只认下面四个键，其他变量请直接 export 或写进 CI secrets。
#
# 解析规则：每行 KEY=VALUE；以 # 开头的整行是注释；不支持行尾注释
# （值里的 # 会被当成内容）；值两侧的空白和成对的单/双引号会被去掉；
# 可以加 export 前缀。

# OpenAI 兼容接口地址。写到 /v1 即可，脚本会自动补 /chat/completions。
AI_API_BASE_URL=https://api.openai.com/v1

# 接口密钥（复制后必须填这一项）。形如 sk-xxxxxxxx。
AI_API_KEY=

# 模型名。
AI_MODEL_NAME=gpt-4o-mini

# 可选：构建尝试次数上限（含首次构建），默认 3。等价于 -n <rounds>。
AI_MAX_FIX_ROUNDS=3
