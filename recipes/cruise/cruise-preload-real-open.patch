The LD_PRELOAD build (CRUISE_PRELOAD) needs __real_open() declared: without
CRUISE_DECL the call is an implicit function declaration, so libcruise.so ends
up with an unresolved __real_open symbol and every `LD_PRELOAD=libcruise.so`
process dies with "symbol lookup error: undefined symbol: __real_open" (the
linker only supplies that symbol in the ld -wrap build).

--- a/src/cruise.c
+++ b/src/cruise.c
@@ -57,6 +57,8 @@
 typedef int64_t off64_t;
 #endif
 
+CRUISE_DECL(open, int, (const char *path, int flags, ...));
+
 static int cruise_fpos_enabled   = 1;  /* whether we can use fgetpos/fsetpos */
 
 int cruise_use_memfs      = 1;
@@ -1011,7 +1013,8 @@
     if (spillblock_fd < 0) {
         if (errno == EEXIST) {
             /* spillover block exists; attach and return */
-            spillblock_fd = __real_open(path, O_RDWR);
+            MAP_OR_FAIL(open);
+            spillblock_fd = CRUISE_REAL(open)(path, O_RDWR);
         } else {
             perror("open() in cruise_get_spillblock() failed");
             return -1;
